# ============================================================
# OneFlesh Web — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── API base URL ──────────────────────────────────────────
# Local dev: http://localhost:4000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:4000

# NOTE: Do NOT add any secret keys here.
# All API keys (Anthropic, AWS, etc.) live in apps/api/.env only.
# Anything prefixed with VITE_ is bundled into the client and
# visible to anyone with browser dev tools.
