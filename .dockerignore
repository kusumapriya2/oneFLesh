# ============================================================
# OneFlesh — .dockerignore
# Excludes files that should not be sent to Docker build context
# ============================================================

# Dependencies (will be installed fresh in container)
node_modules
**/node_modules

# Build outputs (built inside container)
**/dist
**/build
apps/web/dist

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Development tools
.git
.gitignore
.eslintrc*
.prettierrc*
.editorconfig

# Logs
logs
*.log
npm-debug.log*

# Test files
**/__tests__
**/*.test.ts
**/*.spec.ts
**/tests
coverage

# IDE files
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Infrastructure (not needed in app containers)
infrastructure
.github

# Documentation
README.md
docs
*.md

# Temporary files
tmp
temp
.tmp

# Prisma (only schema is needed, migrations applied separately)
apps/api/src/prisma/migrations
